#!/bin/bash

# Git Pre-commit Hook: 自動清理 macOS 隱藏文件
# 在每次 commit 前自動刪除 ._* 文件

# 查找並刪除 ._* 文件
HIDDEN_FILES=$(git ls-files | grep '/\._' || true)

if [ -n "$HIDDEN_FILES" ]; then
    echo "🗑️  發現 macOS 隱藏文件，自動清理中..."
    echo "$HIDDEN_FILES" | xargs git rm -f --cached
    echo "✅ 已從 Git 暫存區移除 ._* 文件"
fi

# 清理工作目錄中的 ._* 文件
find . -name "._*" -type f -delete 2>/dev/null || true

# 執行 Lint-Staged
npx lint-staged

exit 0
