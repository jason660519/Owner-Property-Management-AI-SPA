#!/bin/bash
#
# Pre-commit guard chain. Each step blocks the commit on failure.
# Keep individual checks fast — this runs on EVERY commit.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Clean macOS dotfiles (auto-fix, doesn't block).
HIDDEN_FILES=$(git ls-files | grep '/\._' || true)
if [ -n "$HIDDEN_FILES" ]; then
  echo "🗑️  Removing macOS dotfiles from index..."
  echo "$HIDDEN_FILES" | xargs git rm -f --cached
fi
find . -name "._*" -type f -delete 2>/dev/null || true

# 2. Critical dependency guard — blocks downgrades of React/Next/etc.
echo "🔒 Checking critical dependencies..."
node scripts/check-critical-deps.js

# 3. Block newly-introduced `any` types in staged TS/TSX files.
echo "🚫 Checking for new \`any\` types in staged changes..."
node scripts/check-staged-no-any.js

# 4. Adapter model id prefix guard — only when adapter-config.ts is touched.
if git diff --cached --name-only --diff-filter=AM | grep -qx 'apps/superadmin/lib/adapter-config.ts'; then
  echo "🔌 Linting adapter model ids..."
  bash tools/testing/lint-adapter-model-ids.sh
fi

# 5. Skills sync reminder (non-blocking).
STAGED_FILES="$(git diff --cached --name-only --diff-filter=AM)"
if echo "$STAGED_FILES" | grep -qE '^\.claude/skills/'; then
  if ! echo "$STAGED_FILES" | grep -qE '^(\.agents/skills/|\.codex/skills/|\.cursor/skills/|\.agent/skills/|\.github/skills/|\.opencode/skill/)'; then
    echo "⚠️  Detected staged changes under .claude/skills/"
    echo "   Reminder: run 'npm run sync:skills' and stage synced files when needed."
  fi
fi

# 6. Run lint-staged (prettier + eslint on touched files only).
if git diff --cached --name-only --diff-filter=AM | grep -qE '\.(ts|tsx|js|jsx|json|md)$'; then
  echo "✨ Running lint-staged on touched files..."
  npx --no-install lint-staged
fi

# 7. Secret scanner — blocks .env files and real-looking API keys / PEM keys.
echo "🔐 Scanning staged content for secrets..."
bash tools/security/check-staged-secrets.sh

echo "✅ Pre-commit checks passed."
exit 0
