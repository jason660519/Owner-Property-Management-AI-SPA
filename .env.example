# 房地產 SaaS 專案環境變數範例
# 複製到 .env 檔案並填入您的實際 API keys

# AI 模型 API Keys
ANTHROPIC_API_KEY=sk-demo-1234567890abcdef
GOOGLE_API_KEY=AIzaSyDemoKey1234567890
CONTEXT7_API_KEY=ctx7sk-demo-abcdef123456
CURSOR_API_KEY=key_demo_abcdef1234567890
DEEPSEEK_API_KEY=sk-demo-abcdef1234567890
FIRECRAWL_API_KEY=fc-demo-abcdef1234567890
GEMINI_API_KEY=AIzaSyDemoGeminiKey123456
GITHUB_TOKEN=ghp_demo_abcdef1234567890
GROK_API_KEY=xai-token-demo-abcdef123456
HUGGINGFACE_API_TOKEN=hf_demo_abcdef1234567890
KIMI_K2=sk-demo-kimi-abcdef123456
LLAMA_CLOUD_API_KEY=llx-demo-abcdef1234567890
NGROK_AUTHTOKEN=demo-ngrok-abcdef123456
OPENAI_API_KEY=sk-demo-openai-abcdef123456
OPENROUTER_API_KEY=sk-or-demo-abcdef1234567890
SHODAN_API_KEY=demo-shodan-abcdef123456
SLACK_BOT_TOKEN=demo-slackbot-abcdef123456
TOGETHER_AI_API_KEY=demo-together-abcdef123456

# 開發工具 API Keys
GITHUB_TOKEN=ghp_xxxxx
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_demo
CURSOR_API_KEY=key_demo
CONTEXT7_API_KEY=ctx7sk-demo

# 雲服務和整合
SLACK_BOT_TOKEN=demo-slack-xoxb
SLACK_TEAM_ID=Tdemo123456
NOTION_API_KEY=secret_demo
HUGGINGFACE_API_TOKEN=hf_demo
FIRECRAWL_API_KEY=fc_demo

# 其他工具
NGROK_AUTHTOKEN=demo-ngrok
SHODAN_API_KEY=demo-shodan
KIMI_K2=sk-demo
LLAMA_CLOUD_API_KEY=llx-demo

# Google Drive OAuth (完整路徑)
GDRIVE_OAUTH_PATH=/path/to/demo/client_secret.json

# 資料庫和基礎設施
# 與 Supabase CLI 本機一致（supabase/config.toml [db] port，預設 54322）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://demo:demo@localhost:6379
DOCKER_HOST=unix:///var/run/docker.sock

# 房地產 SaaS 專用
SECRET_KEY=demo-super-secret-key
ALGORITHM=HS256
AWS_ACCESS_KEY_ID=demo-access-key
AWS_SECRET_ACCESS_KEY=demo-secret-key
S3_BUCKET_NAME=demo-realestate-files

# Email Service (SMTP)
SMTP_HOST=localhost
SMTP_PORT=54325
SMTP_USER=test
SMTP_PASS=test

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 雙站分離：主站 (房東/租客/買家) 與超級管理員後台
# 主站 (apps/web) - Port 3000。可選：超級管理員後台 URL，用於登入後導向與連結
NEXT_PUBLIC_SUPERADMIN_URL=http://localhost:3001
# 超級管理員站 (apps/superadmin) - Port 3001。可選：主站 URL，用於「前往主站」與非 super_admin 導向
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000
