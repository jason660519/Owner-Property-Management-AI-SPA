{
  "_comment": "Row 145 Sprint 5 — people_database v2 mapping (IK analyzer + blue/green reindex target). Differences vs v1: (a) name uses ik_smart for index + ik_max_word for search (v1 was reversed, which over-tokenizes Chinese names); (b) explicit person_id / record_count fields ready for Sprint 4 entity resolution; (c) explicit address.tokens subfield for prefix queries. IK plugin assumed installed (see backend/elasticsearch/Dockerfile). Custom dictionary expansion (rare surnames like 闕) is Sprint 6 work; for now, surname/given splits will fall back to char-level for OOV characters.",
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "ik_smart_analyzer": {
          "type": "custom",
          "tokenizer": "ik_smart"
        },
        "ik_max_word_analyzer": {
          "type": "custom",
          "tokenizer": "ik_max_word"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "person_id": { "type": "keyword" },
      "record_count": { "type": "integer" },

      "name": {
        "type": "text",
        "analyzer": "ik_smart_analyzer",
        "search_analyzer": "ik_max_word_analyzer",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 }
        }
      },
      "name_pinyin": { "type": "keyword" },

      "id_number": { "type": "keyword" },
      "phone": { "type": "keyword" },
      "phone_normalized": { "type": "keyword" },
      "email": { "type": "keyword" },
      "company": {
        "type": "text",
        "analyzer": "ik_smart_analyzer",
        "fields": {
          "keyword": { "type": "keyword", "ignore_above": 256 }
        }
      },

      "address": {
        "type": "text",
        "analyzer": "ik_max_word_analyzer",
        "search_analyzer": "ik_smart_analyzer",
        "fields": {
          "tokens": { "type": "keyword" }
        }
      },
      "address_normalized": { "type": "keyword" },
      "address_county": { "type": "keyword" },
      "address_district": { "type": "keyword" },
      "address_road": { "type": "keyword" },
      "address_tokens": { "type": "keyword" },

      "dataset_root": { "type": "keyword" },
      "dataset_subpath": { "type": "keyword" },
      "dataset_path": { "type": "keyword" },
      "data_source": { "type": "keyword" },
      "source_file_sha256": { "type": "keyword" },

      "batch_id": { "type": "keyword" },
      "batch_label": { "type": "keyword" },
      "duplicate_flag": { "type": "keyword" },
      "created_at": { "type": "date" },
      "updated_at": { "type": "date" }
    }
  }
}
