# Copy this file to .env.paperclip and adjust values if needed.
# start.sh will auto-generate .env.paperclip if missing.

PAPERCLIP_PORT=3187
PAPERCLIP_PUBLIC_URL=http://localhost:3187
PAPERCLIP_DASHBOARD_URL=http://localhost:3187/VIS/agents/ceo/dashboard
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest
PAPERCLIP_AUTO_PULL=0
PAPERCLIP_AUTO_OPEN_BROWSER=1
PAPERCLIP_DATA_DIR=./data/docker-paperclip

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_me

# Required for running claude_local adapter via subscription auth (avoid per-request billing).
# Keep this value local-only; DO NOT commit it.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: enable adapters inside container
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
